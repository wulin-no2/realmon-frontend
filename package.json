{
  "type": "module",
  "name": "realmon-frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir web-build",
    "dev-start": "EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0 node scripts/dev-start.ts",
    "dev": "EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0 expo start"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@ngrok/ngrok": "^1.7.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.11",
    "@react-navigation/native": "^7.1.7",
    "@react-navigation/native-stack": "^7.3.11",
    "axios": "^1.9.0",
    "expo": "~53.0.7",
    "expo-dev-client": "~5.2.4",
    "expo-image-picker": "~16.1.4",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.3",
    "expo-status-bar": "~2.2.3",
    "lodash.throttle": "^4.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-map-link": "^3.9.0",
    "react-native-maps": "1.26.18",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^22.15.29",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.72.8",
    "@types/react-native-vector-icons": "^6.4.18",
    "dotenv": "^16.5.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.0",
    "node-fetch": "^2.7.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@react-navigation/.*|react-native-svg)"
    ]
  }
}
